PORT=5000
DATABASE_URL=your_postgres_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS
CLIENT_URL=http://localhost:5173
# Links in verification and password-reset emails
FRONTEND_URL=http://localhost:5173
# Existing user promoted to admin on startup
ADMIN_EMAIL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Firebase sends signup verification and password-reset email. Postgres still stores the account.
FIREBASE_PROJECT_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend sends verification and reset mail over HTTPS, which the free Render plan allows.
# Create the key in the Resend dashboard. Do not commit the real value.
# Until nanoapps.in is verified in Resend, mail can only go to the Resend account inbox
# and the from address must stay onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=Nanoapps <onboarding@resend.dev>

# Mailbox that sends password-reset and verification email.
# Hostinger: smtp.hostinger.com, port 465, SMTP_SECURE=true
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and an app password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@nanoapps.in
SMTP_PASS=
EMAIL_FROM=Nanoapps <support@nanoapps.in>
CONTACT_EMAIL=support@nanoapps.in
